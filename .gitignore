# ====================================
# Android / Kotlin .gitignore
# OpenCode Android Client
# ====================================

# Built application files
*.apk
*.aab
*.ap_
*.dex

# Files for the ART/Dalvik VM
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
.idea/misc.xml
.idea/compiler.xml
.idea/workspace.xml
.idea/libraries/
.idea/jarRepositories.xml
.idea/caches/
.idea/modules.xml
.idea/.name
.idea/vcs.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetDropDown.xml
.idea/gradle.xml
.idea/ktlint.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# Google Services (if applicable)
google-services.json

# Fabric plugin (if applicable)
fabric.properties

# Android Profiling
*.hprof

# Kotlin
*.kotlin_module

# OS-specific files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Secrets and credentials
*.keystore
*.jks
secrets.properties
apikey.properties

# Signing configs
signing.properties

# Gradle wrapper (uncomment to exclude)
# gradle/wrapper/gradle-wrapper.jar

# lint
lint-report.html
lint-results.xml
lint-results_files/

# Backup files
*~
*.swp
*.swo
*.bak
